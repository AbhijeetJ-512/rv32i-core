<mxfile host="app.diagrams.net" agent="dgm.py" version="24.0.0">
<diagram id="rv32i-core---life-of-one-instruction-(operation-flowchart)" name="RV32I core - life of one instruction (operation flowchart)">
<mxGraphModel dx="1200" dy="1260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1260" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="reset" value="&lt;b&gt;Reset: rst_n low&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;pc_f &amp;lt;- RESET_PC, valid bits cleared, halted &amp;lt;- 0&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="335" y="55" width="400" height="55" as="geometry"/></mxCell>
<mxCell id="if" value="&lt;b&gt;IF: fetch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;imem_addr = pc_f ; IF/ID &amp;lt;- {pc, instr}&lt;br&gt;next PC = pc + 4 unless redirected&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="270" height="62" as="geometry"/></mxCell>
<mxCell id="id" value="&lt;b&gt;ID: decode, read registers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;rs1/rs2 (write-first bypass), immediate,&lt;br&gt;control signals, forward selects&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="230" width="270" height="62" as="geometry"/></mxCell>
<mxCell id="dtrap" value="&lt;b&gt;ECALL / EBREAK or&lt;br&gt;illegal encoding?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="322" width="270" height="78" as="geometry"/></mxCell>
<mxCell id="mark" value="&lt;b&gt;Mark the instruction as a trap&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;no register, memory or PC effect of its own&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="332" width="330" height="58" as="geometry"/></mxCell>
<mxCell id="dlu" value="&lt;b&gt;Load-use hazard?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;a load in EX writes rs1 / rs2&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="432" width="270" height="82" as="geometry"/></mxCell>
<mxCell id="stall" value="&lt;b&gt;Stall one cycle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;hold PC and IF/ID,&lt;br&gt;bubble into ID/EX&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="445" width="250" height="62" as="geometry"/></mxCell>
<mxCell id="ex" value="&lt;b&gt;EX: execute&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;forward operands (MEM / WB / register),&lt;br&gt;ALU, branch compare, targets&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="548" width="270" height="62" as="geometry"/></mxCell>
<mxCell id="dred" value="&lt;b&gt;Redirect needed?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;JALR, taken branch (BP0), JAL (BP0),&lt;br&gt;misprediction (BP1)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="640" width="270" height="90" as="geometry"/></mxCell>
<mxCell id="flush" value="&lt;b&gt;Flush IF/ID and ID/EX&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;PC &amp;lt;- target_ex   (2 bubbles)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="660" width="330" height="58" as="geometry"/></mxCell>
<mxCell id="dtex" value="&lt;b&gt;Trap marked in EX?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="762" width="270" height="78" as="geometry"/></mxCell>
<mxCell id="halt" value="&lt;b&gt;Squash younger instructions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;halted &amp;lt;- 1 ; retire with halt (and trap)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="772" width="330" height="62" as="geometry"/></mxCell>
<mxCell id="dmem" value="&lt;b&gt;Load or store?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="872" width="270" height="78" as="geometry"/></mxCell>
<mxCell id="dmis" value="&lt;b&gt;Misaligned address?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;half: odd, word: not multiple of 4&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="982" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="tmem" value="&lt;b&gt;Trap in MEM: no memory access&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;squash younger, halted &amp;lt;- 1,&lt;br&gt;retire with halt + trap&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="992" width="330" height="62" as="geometry"/></mxCell>
<mxCell id="acc" value="&lt;b&gt;MEM: access data memory&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;byte strobes, lane shift, sign / zero extend&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="1092" width="270" height="60" as="geometry"/></mxCell>
<mxCell id="wb" value="&lt;b&gt;WB: write rd (rd != x0), retire&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;RVFI record on the trace port&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="1172" width="270" height="50" as="geometry"/></mxCell>
<mxCell id="stop" value="&lt;b&gt;Core stopped&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;older instructions drain and retire first&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="1092" width="330" height="55" as="geometry"/></mxCell>
<mxCell id="done" value="&lt;b&gt;Instruction retired&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="790" y="1172" width="330" height="50" as="geometry"/></mxCell>
<mxCell id="note" value="Redirect and trap decisions are made in EX; the misalignment trap is detected in MEM from the registered address.&lt;br&gt;A load-use stall needs a load in EX and a redirect needs a branch or jump in EX, so the two never occur in the same cycle." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#222222;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1232" width="759.52" height="33.5" as="geometry"/></mxCell>
