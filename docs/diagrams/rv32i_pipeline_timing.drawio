<mxCell id="hc" value="cycle" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#222222;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="65" width="41.6" height="21" as="geometry"/></mxCell>
<mxCell id="n1" value="Cycle 3: the load is in EX and add (in ID) needs x1, so a load-use stall holds the PC and IF/ID for one cycle and a bubble enters EX; sub is fetched twice.&lt;br&gt;Cycle 5: the load is in WB when add reaches EX, so x1 is forwarded from WB. Cycles 6 and 7: back-to-back dependences are forwarded from MEM, no stall.&lt;br&gt;Cycle 7: beq resolves in EX and is taken: or (in ID) and and (in IF) are squashed (x) and the PC is loaded with T; xor is fetched in cycle 8." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#222222;fontStyle=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="581" width="962.8" height="47.25" as="geometry"/></mxCell>
<mxCell id="n2" value="Blue arrows: forwarding. Red slots: a stall or a squashed instruction. In BP_MODE=1 a taken backward branch would redirect from ID instead (1 bubble)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#222222;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="643" width="848" height="18.5" as="geometry"/></mxCell>
