## Sky130 HD platform variable definitions
## Copied from Projects/Full-Adder/sky130hd/ (that project is untouched). Changes in this copy:
##  - the multi-corner `liberty_files` list is removed (the fast/slow libraries are not copied; the flow is single-corner)
##  - sky130hd.pdn.tcl is the OpenROAD distribution's own (met1 rails + met4/met5 stripes), NOT Full-Adder's: that one is a
##    "minimal PDN for a tiny full-adder demo" (met2 stripes every 5.44 um) and detailed placement cannot legalise the wide
##    mux4_2 cells between them (105 of 1625 cells failed with DPL-0036; with the distribution's PDN they place)
##  - `dont_use` also excludes the sky130_fd_sc_hd__lpflow_* cells (low-power-flow cells; Full-Adder's netlist used one)

# Logical platform name used for result file naming.
set platform "sky130hd"

# Technology LEF (routing layers, design rules) and standard cell LEF (cell abstracts)
set tech_lef "sky130hd/sky130hd.tlef"
set std_cell_lef "sky130hd/sky130hd_std_cell.lef"
set extra_lef {}            ;# Additional LEF files (macros etc.) if needed

# Liberty timing/power model for typical corner (used by OpenSTA / optimization)
set liberty_file "sky130hd/sky130hd_tt.lib"

set extra_liberty {}        ;# Placeholder for any extra libs

# Standard cell placement site name
set site "unithd"

# Power distribution network config script & routing tracks file
set pdn_cfg "sky130hd/sky130hd.pdn.tcl"
set tracks_file "sky130hd/sky130hd.tracks"

# IO pin placer preferred routing layers (horizontal / vertical)
set io_placer_hor_layer met3
set io_placer_ver_layer met2

# Tapcell insertion parameters (ensure well taps every distance) with master cell
set tapcell_args "-distance 14 \
    -tapcell_master sky130_fd_sc_hd__tapvpwrvgnd_1"

# Target global placement density (fraction of core area to occupy with cells)
set global_place_density 0.9
set global_place_density_penalty 8e-5  ;# Default penalty to discourage overfill

# Padding (in site units) added left/right of every std cell during placement
set global_place_pad 4
set detail_place_pad 2                 ;# Reduced padding for detailed placement

set macro_place_halo {1 1}             ;# Macro keepout halo (unused here: no macros)

set layer_rc_file "sky130hd/sky130hd.rc"  ;# Layer RC estimates for early parasitics
set wire_rc_layer "met2"                 ;# Signal representative RC layer
set wire_rc_layer_clk "met5"             ;# Hypothetical clock layer (CTS skipped here)
set tielo_port "sky130_fd_sc_hd__conb_1/LO" ;# Constant low port for tie insertion
set tiehi_port "sky130_fd_sc_hd__conb_1/HI" ;# Constant high port
set tie_separation 5                     ;# Minimum distance between tie cells (microns)
set cts_buffer "sky130_fd_sc_hd__clkbuf_4" ;# Default clock buffer (unused: no clock)
set cts_cluster_diameter 100             ;# Placeholder value for future CTS
set filler_cells "sky130_fd_sc_hd__fill_*" ;# Filler cell pattern inserted after routing

set dont_use {sky130_fd_sc_hd__probe_p_* sky130_fd_sc_hd__probec_p_* sky130_fd_sc_hd__lpflow_*} ;# Cells to exclude

set global_routing_layers met1-met5          ;# Allowed routing layers for signals
set global_routing_clock_layers met3-met5    ;# Preferred (unused) clock layers
set global_routing_layer_adjustments {{met1 0.5} {met2 0.5} {met3 0.5} {met4 0.5} {met5 0.5}} ;# Congestion adjustments

set min_routing_layer met1       ;# Lower bound layer for detailed routing
set max_routing_layer met5       ;# Upper bound layer

set rcx_rules_file "sky130hd/sky130hd.rcx_rules" ;# If present, used for extraction

# Local Variables:
# mode:tcl
# End:
